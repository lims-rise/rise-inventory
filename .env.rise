# Salin baris-baris ini ke file .env proyek Laravel (ganti nilai yang sudah ada)

APP_NAME="RISE Inventory"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://rise-inventory.test
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rise_inventory
DB_USERNAME=root
DB_PASSWORD=
# Samakan dengan 'char_set' di application/config/database.php CI3 (umumnya utf8)
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Pakai file, BUKAN database, supaya tidak perlu membuat tabel baru di rise_inventory
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
